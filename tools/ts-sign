#
# ts-sign — sign a TownSquare event with this agent's SSH key.
#
#   ts-sign EVENT.txt [KEY]
#
# Produces a DETACHED signature EVENT.txt.sig. Detached matters: the event file
# is never modified, so signing does not violate the append-only rule.
#
# The signature namespace "townsquare" prevents a signature made for one purpose
# being replayed as another.
set -eu
NS="${TS_SIG_NAMESPACE:-townsquare}"
FILE="${1:?usage: ts-sign EVENT.txt [KEY]}"
KEY="${2:-${TS_SIGNING_KEY:-$HOME/.ssh/id_ed25519}}"

[ -f "$FILE" ] || { echo "ts-sign: no such file: $FILE" >&2; exit 1; }
[ -f "$KEY" ]  || { echo "ts-sign: no signing key: $KEY" >&2; exit 1; }

# The filename carries priority, assignee and state. Signing only the body would
# leave those unprotected, so the body's header MUST match the filename - a rule
# ts-verify enforces. Together, a rename breaks the header match and an edit
# breaks the signature.
base=$(basename "$FILE" .txt)
hdr_id=$(sed -n 's/^id:[[:space:]]*//p'       "$FILE" | head -1)
hdr_ev=$(sed -n 's/^event:[[:space:]]*//p'    "$FILE" | head -1)
hdr_st=$(sed -n 's/^state:[[:space:]]*//p'    "$FILE" | head -1)
hdr_pri=$(sed -n 's/^priority:[[:space:]]*//p' "$FILE" | head -1)
hdr_to=$(sed -n 's/^to:[[:space:]]*//p'        "$FILE" | head -1)

case "$base" in
  "$hdr_id.$hdr_ev-$hdr_st"*) : ;;
  *) echo "ts-sign: REFUSING - header ($hdr_id.$hdr_ev-$hdr_st) does not match filename ($base)" >&2
     exit 2 ;;
esac

# EVERY ROUTING FIELD THE FILENAME CARRIES MUST BE BOUND BY THE SIGNED BODY.
# Binding only id/event/state leaves __P<n>__ and __to-<host>__ - priority and
# assignee - forgeable by rename: a signed P3 for one host becomes a "verified"
# P0 for another with a copy. Demonstrated 2026-09-06.
name_pri=$(echo "$base" | tr '_' '\n' | grep -E '^P[0-3]$' | head -1)
name_to=$(echo "$base"  | tr '_' '\n' | sed -n 's/^to-//p'  | head -1)
if [ -n "$name_pri" ] && [ "$name_pri" != "$hdr_pri" ]; then
    echo "ts-sign: REFUSING - filename says priority $name_pri, header says '${hdr_pri:-none}'" >&2
    echo "  add 'priority: $name_pri' to the header, or the name is unbound." >&2
    exit 2
fi
if [ -n "$name_to" ] && [ "$name_to" != "$hdr_to" ]; then
    echo "ts-sign: REFUSING - filename says to-$name_to, header says '${hdr_to:-none}'" >&2
    echo "  add 'to: $name_to' to the header, or the name is unbound." >&2
    exit 2
fi

# Events are immutable, so a signature that already exists should not be
# silently replaced - that would mask a substitution. Re-signing is a no-op.
if [ -f "$FILE.sig" ]; then
    echo "already signed: $FILE.sig (not replaced)"
    exit 0
fi

ssh-keygen -Y sign -f "$KEY" -n "$NS" "$FILE" </dev/null >/dev/null 2>&1
[ -f "$FILE.sig" ] || { echo "ts-sign: signing failed" >&2; exit 1; }
echo "signed: $FILE.sig  ($(ssh-keygen -lf "$KEY.pub" 2>/dev/null | awk '{print $2}'))"
