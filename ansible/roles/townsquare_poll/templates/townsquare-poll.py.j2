"""
TownSquare host poller — refreshes this host's work into a local drop file.

Runs for a fraction of a second and exits. Nothing resident, no daemon, no open
connection, no privilege. Schedule it from the user's own crontab.

Written in Python rather than shell deliberately: an earlier version embedded
`python -c` inside sh inside a template, and the nested quoting silently mangled
the output so the drop file rendered EMPTY while reporting success. Every host
then read "nothing open" when work existed. One language, no quoting boundary.
"""
import json
import os
import sys
import urllib.request
from datetime import datetime, timezone

CRIER = "{{ townsquare_crier_url }}"
HOST = "{{ townsquare_host_name }}"
DIR = os.path.expanduser("{{ townsquare_drop_dir }}")
DROP = os.path.join(DIR, "NEW-EVENTS.txt")
STATE = os.path.join(DIR, "last_seq")
TIMEOUT = int(os.environ.get("TS_TIMEOUT", "10"))
ORDER = {"P0": 0, "P1": 1, "P2": 2, "P3": 3}


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def get(path: str):
    with urllib.request.urlopen(CRIER + path, timeout=TIMEOUT) as r:
        return json.loads(r.read().decode())


def write(lines) -> None:
    os.makedirs(DIR, exist_ok=True)
    tmp = DROP + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, DROP)


def read_last():
    try:
        with open(STATE) as f:
            return f.read().strip()
    except OSError:
        return None


SEEN = os.path.join(DIR, "seen_bulletins")
BLOG = os.path.join(DIR, "BULLETINS.log")


def log_bulletins(names):
    """NEVER TRUNCATED. The drop file is overwritten every poll, so a bulletin
    announced once is gone five minutes later and the next poll says nothing
    with complete confidence. Venom measured exactly this on its own poller
    (BB-20260908-venom-011.003): the machine noticed, and no one was there.
    A detection with a five-minute lifetime is worse than no detection."""
    os.makedirs(DIR, exist_ok=True)
    with open(BLOG, "a") as f:
        for n in sorted(names):
            f.write(f"{now()}  {n}\n")


def read_seen():
    try:
        with open(SEEN) as f:
            return set(l.strip() for l in f if l.strip())
    except OSError:
        return set()


def write_seen(names):
    """Never truncates to fewer than it knew. A detection with a five-minute
    lifetime is worse than no detection, because the next poll then says
    'no change' with complete confidence."""
    os.makedirs(DIR, exist_ok=True)
    tmp = SEEN + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(sorted(names)) + "\n")
    os.replace(tmp, SEEN)


def main() -> int:
    last = read_last()
    try:
        wm = get("/watermark")
    except Exception as e:  # noqa: BLE001
        # UNREACHABLE IS NOT "NO WORK". A notification system that fails
        # silently is worse than none, because it gets trusted.
        write([
            "TOWNSQUARE - CRIER UNREACHABLE",
            f"checked:     {now()}",
            f"crier:       {CRIER}",
            f"error:       {type(e).__name__}: {e}",
            f"last known:  seq {last if last else 'never'}",
            "",
            "This is UNKNOWN, not 'no work'. Do not read an empty list as quiet.",
            "Check the Crier service, or query the ledger directly.",
        ])
        return 0

    seq = str(wm.get("seq", ""))
    changed = f" (CHANGED from {last})" if last is not None and seq != last else ""
    lines = [
        f"TOWNSQUARE - open work for {HOST}",
        f"refreshed:   {now()}",
        f"watermark:   seq {seq}{changed}",
        f"crier poll:  {wm.get('last_poll_ok', 'unknown')}",
        "",
    ]
    try:
        data = get(f"/open?host={HOST}")
        threads = data.get("threads", [])
        if not threads:
            lines.append("  Nothing open addressed to this host.")
        else:
            threads.sort(key=lambda t: (ORDER.get(t.get("priority"), 4), t["thread"]))
            for t in threads:
                tag = "CLOSE" if t.get("action") == "close" else " WORK"
                # Surface integrity here: this drop file is what agents read.
                # Verification a consumer never sees buys nothing.
                # THREE OUTCOMES, NOT TWO. verified=None means NOT EVALUATED -
                # the Crier stopped verifying on 2026-09-08 by operator direction,
                # so every event now reads null. Labelling that "unsigned" is a
                # measurement artefact reported as a fact about the event, and it
                # was audited on this host in BB-20260908-venom-020.001.
                # A missing roster entry is a fact about the ROSTER.
                v, sg = t.get("verified"), t.get("signed")
                if v is True:
                    mark = "sig-ok  "
                elif v is False:
                    mark = "SIG-BAD "
                elif sg:
                    mark = "signed  "      # signature present, not checked
                else:
                    mark = "unsigned"      # genuinely carries no signature
                lines.append(
                    f"  [{tag}] {t.get('priority') or '--'}  {t['thread']}  "
                    f"{t.get('state', ''):<9} {mark}  {t.get('subject') or ''}"
                )
            lines += ["", f"  Detail:  curl -s {CRIER}/thread/<id>",
                      f"  In flight elsewhere:  curl -s {CRIER}/active"]
    except Exception as e:  # noqa: BLE001
        lines += [f"  Could not fetch open work: {type(e).__name__}: {e}",
                  "  Treat as UNKNOWN, not as no work."]

    # TO-ALL BULLETINS. /open?host= returns ONLY threads addressed to this host,
    # so a to-all bulletin - which is how doctrine versions and protocol rules
    # arrive - is invisible to it. Measured on this host: /open?host=wolverine
    # returned 0 Bulletin entries while four fleet-impacting bulletins were live.
    # Six Linux hosts polled /watermark + /open all of 2026-09-08 and could not
    # see a single one. Detection was never the problem; coverage was.
    if last is None or seq != last:
        try:
            payload = get(f"/events?since={last or 0}")
            known = read_seen()
            seeding = not os.path.exists(SEEN)
            fresh = []
            for th in payload.get("threads", []):
                if th.get("board") != "Bulletin Board":
                    continue
                if th.get("to") not in ("all", HOST):
                    continue
                for e in th.get("events", []):
                    fn = e.get("filename")
                    if fn and fn not in known:
                        fresh.append(fn)
            if fresh and seeding:
                # FIRST RUN. Printing the whole back-catalogue produces a drop
                # file nobody reads, which is the failure this fix exists to
                # cure, one layer along. Record the baseline, say so in one
                # line, and report only what arrives AFTER this.
                write_seen(known | set(fresh))
                lines += ["", f"  Bulletin baseline established: {len(fresh)} existing "
                              "bulletin(s) recorded as seen.",
                          "  New ones will be listed individually from the next poll on.",
                          f"  To read the back-catalogue:  curl -s {CRIER}/events?since=0"]
            elif fresh:
                log_bulletins(fresh)
                lines += ["", f"  ** {len(fresh)} BULLETIN(S) YOU HAVE NOT SEEN - "
                              "doctrine and protocol arrive this way:"]
                for fn in sorted(fresh):
                    lines.append(f"     {fn}")
                lines.append("     READ THESE BEFORE ACTING. A bulletin is never the work,")
                lines.append("     but it can change what the work means.")
                lines.append(f"     Persisted (never truncated): {BLOG}")
                write_seen(known | set(fresh))
        except Exception as e:  # noqa: BLE001
            lines += ["", f"  Bulletin sweep unavailable: {type(e).__name__}. "
                          "Fleet-wide notices are UNKNOWN, not absent."]

    # Board-wide id collisions. Not scoped to this host on purpose: a thread
    # wearing one id for two requests is everyone's problem, and the agent who
    # can see it is the one who happens to be reading.
    try:
        cols = [c for c in (get("/fleet").get("collisions") or [])
                if c.get("unresolved")]
        if cols:
            lines += ["", f"  !! {len(cols)} THREAD(S) WITH COLLIDING IDS - "
                          "two requests may be wearing one id:"]
            for c in cols:
                bits = []
                if c.get("duplicate_openings"):
                    bits.append(f"{c['duplicate_openings']} opening events")
                if c.get("duplicate_sequences"):
                    bits.append("duplicate seq "
                                + ",".join(str(q) for q in c["duplicate_sequences"]))
                lines.append(f"     {c['thread']}  ({'; '.join(bits)})")
            lines.append("     Reconcile by appending, never by deleting.")
    except Exception as e:  # noqa: BLE001
        lines += ["", f"  Collision check unavailable: {type(e).__name__}. "
                      "Board integrity is UNKNOWN."]

    write(lines)
    os.makedirs(DIR, exist_ok=True)
    with open(STATE, "w") as f:
        f.write(seq)
    return 0


if __name__ == "__main__":
    sys.exit(main())
