# Town Registrar viewer — Compose environment. Copy to `.env` beside compose.yml.
# This file contains PATHS AND NAMES, never a credential value.

# Absolute path on the NAS to the file holding the read-only bearer token
# (principal=townsquare-viewer, scope=post:read). Compose bind-mounts it at
# /run/secrets/viewer_api_token with its host ownership intact, so it must be
# readable by UID 10002:  chown root:10002 <file> && chmod 0640 <file>
VIEWER_TOKEN_FILE=/volume1/home/batman/town-registrar/secrets/viewer-api-token

# The Docker network the Registrar's Compose project created. The default below
# is `<project name>_<network name>` for a stack named `townsquare-registrar`.
# Verify with `docker network ls` before the first start.
REGISTRAR_NETWORK=townsquare-registrar_registrar-internal
