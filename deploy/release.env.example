# Copy outside the repository, chmod 0600, and replace every value.
# Values are immutable image references, never tags such as :latest.
TOWNSQUARE_LEDGER_IMAGE=registry.example.invalid/townsquare/ledger@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_VIEWER_IMAGE=registry.example.invalid/townsquare/viewer@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_REGISTRY_IMAGE=registry.example.invalid/townsquare/registry@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_BACKUP_IMAGE=registry.example.invalid/townsquare/backup@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_LEDGER_DATA_DIR=/absolute/local/path/townsquare-ledger
TOWNSQUARE_REGISTRY_DATA_DIR=/absolute/local/path/townsquare-registry
TOWNSQUARE_BACKUP_DIR=/absolute/local/path/townsquare-backups
TOWNSQUARE_TOKEN_PEPPER_FILE=/absolute/secret/token-pepper
TOWNSQUARE_CURSOR_SIGNING_KEY_FILE=/absolute/secret/cursor-signing-key
TOWNSQUARE_RECEIPT_HASH_KEY_FILE=/absolute/secret/receipt-hash-key
TOWNSQUARE_VIEWER_API_TOKEN_FILE=/absolute/secret/viewer-read-token
TOWNSQUARE_REGISTRY_API_TOKEN_FILE=/absolute/secret/registry-service-token
TOWNSQUARE_REGISTRY_LEDGER_AUDIT_TOKEN_FILE=/absolute/secret/registry-ledger-audit-token
TOWNSQUARE_BACKUP_RECIPIENT_FILE=/absolute/secret/age-recipient
TOWNSQUARE_CONTEXT_MANIFEST=/absolute/config/context-manifest.json
