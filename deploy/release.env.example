# Copy outside the repository, chmod 0600, replace every placeholder, and
# preserve the four reviewed non-secret REGISTRY_SESSION_* values exactly.
# Values are immutable image references, never tags such as :latest.
TOWNSQUARE_LEDGER_IMAGE=registry.example.invalid/townsquare/ledger@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_VIEWER_IMAGE=registry.example.invalid/townsquare/viewer@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_REGISTRY_IMAGE=registry.example.invalid/townsquare/registry@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_BACKUP_IMAGE=registry.example.invalid/townsquare/backup@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_PYTHON_IMAGE=python@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_AGE_VERSION=REPLACE_WITH_EXACT_APT_VERSION
TOWNSQUARE_MINISIGN_VERSION=REPLACE_WITH_EXACT_APT_VERSION
TOWNSQUARE_RUNTIME_CLASS=CANARY
TOWNSQUARE_AUTHORITY_CLASS=NON-AUTHORITATIVE
TOWNSQUARE_CANARY_LABEL=TS-CANARY-NAS1-20261007-A
TOWNSQUARE_COMPOSE_PROJECT=townsquare-canary-20261007-a
TOWNSQUARE_SOURCE_COMMIT=REPLACE_WITH_EXACT_REGISTRY_SUCCESSOR_COMMIT
TOWNSQUARE_SOURCE_TREE=REPLACE_WITH_EXACT_REGISTRY_SUCCESSOR_TREE
TOWNSQUARE_R7_RELEASE_ID=TS-R7-REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_R7_INPUT_MANIFEST_SHA256=REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_R7_IDENTITY_SHA256=REPLACE_WITH_VERIFIED_64_HEX_DIGEST
TOWNSQUARE_R7_IDENTITY_FILE=/absolute/config/r7-identity.json
TOWNSQUARE_LEDGER_DATA_DIR=/absolute/local/path/townsquare-ledger
TOWNSQUARE_REGISTRY_DATA_DIR=/absolute/local/path/townsquare-registry
REGISTRY_SESSION_BIND_HOST=0.0.0.0
REGISTRY_SESSION_BIND_PORT=8793
REGISTRY_SESSION_PUBLIC_URL=http://registry:8793
REGISTRY_SESSION_LISTENER_SHA256=6822f4d0ec8da1e2c56120c925a8dd6f068f85d6030eab84055a2a0789167b7d
TOWNSQUARE_BACKUP_DIR=/absolute/local/path/townsquare-backups
TOWNSQUARE_TOKEN_PEPPER_FILE=/absolute/secret/token-pepper
TOWNSQUARE_CURSOR_SIGNING_KEY_FILE=/absolute/secret/cursor-signing-key
TOWNSQUARE_RECEIPT_HASH_KEY_FILE=/absolute/secret/receipt-hash-key
TOWNSQUARE_VIEWER_API_TOKEN_FILE=/absolute/secret/viewer-read-token
TOWNSQUARE_REGISTRY_API_TOKEN_FILE=/absolute/secret/registry-service-token
TOWNSQUARE_REGISTRY_LEDGER_AUDIT_TOKEN_FILE=/absolute/secret/registry-ledger-audit-token
TOWNSQUARE_REGISTRY_LEDGER_READINESS_TOKEN_FILE=/absolute/secret/registry-ledger-readiness-token
TOWNSQUARE_LEDGER_REGISTRY_READINESS_TOKEN_FILE=/absolute/secret/ledger-registry-readiness-token
REGISTRY_LEDGER_AUDIT_CREDENTIAL_REVISION=1
LEDGER_READINESS_CREDENTIAL_REVISION=1
REGISTRY_PEER_READINESS_CREDENTIAL_REVISION=1
TOWNSQUARE_AUTHORITY_PUBLIC_KEY_FILE=/absolute/config/authority-public-key
TOWNSQUARE_AUTHORITY_PROOF_FILE=/absolute/config/authority-proof.json
TOWNSQUARE_AUTHORITY_SIGNATURE_FILE=/absolute/config/authority-proof.minisig
TOWNSQUARE_BACKUP_RECIPIENT_FILE=/absolute/secret/age-recipient
TOWNSQUARE_CONTEXT_MANIFEST=/absolute/config/context-manifest.json
