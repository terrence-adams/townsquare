{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:townsquare:contract:notice-pointer:1",
  "title": "TownSquare notice-pointer/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "delivery_id",
    "notice_id",
    "event_id",
    "generation",
    "recipient_agent_id",
    "recipient_host_id",
    "recipient_seat_id",
    "source_target",
    "courier_profile",
    "route_evidence"
  ],
  "properties": {
    "contract": {
      "const": "notice-pointer/1"
    },
    "delivery_id": {
      "$ref": "#/$defs/token"
    },
    "notice_id": {
      "$ref": "#/$defs/token"
    },
    "event_id": {
      "$ref": "#/$defs/token"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "recipient_agent_id": {
      "$ref": "#/$defs/token"
    },
    "recipient_host_id": {
      "$ref": "#/$defs/token"
    },
    "recipient_seat_id": {
      "$ref": "#/$defs/token"
    },
    "source_target": {
      "$ref": "#/$defs/targetRef"
    },
    "courier_profile": {
      "enum": [
        "HOST_COURIER",
        "DIRECT_AGENT"
      ]
    },
    "route_evidence": {
      "$ref": "#/$defs/routeEvidence"
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "kind",
        "id"
      ],
      "properties": {
        "contract": {
          "const": "target-ref/1"
        },
        "kind": {
          "enum": [
            "AGENT",
            "HOST"
          ]
        },
        "id": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "routeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "snapshot_id",
        "watermark",
        "canonical_sha256",
        "recipients_sha256",
        "recipient_sha256"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/token"
        },
        "snapshot_id": {
          "$ref": "#/$defs/token"
        },
        "watermark": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recipients_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recipient_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
