{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:townsquare:contract:target-ref:1",
  "title": "TownSquare target-ref/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "kind",
    "id"
  ],
  "properties": {
    "contract": {
      "const": "target-ref/1"
    },
    "kind": {
      "enum": [
        "AGENT",
        "HOST"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
