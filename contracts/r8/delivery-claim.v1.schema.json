{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:townsquare:contract:delivery-claim:1",
  "title": "TownSquare delivery-claim/1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "form",
        "request_id",
        "idempotency_key",
        "request_body_sha256",
        "limit"
      ],
      "properties": {
        "contract": {
          "const": "delivery-claim/1"
        },
        "form": {
          "const": "REQUEST"
        },
        "request_id": {
          "$ref": "#/$defs/token"
        },
        "idempotency_key": {
          "$ref": "#/$defs/token"
        },
        "request_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "form",
        "request_id",
        "idempotency_key",
        "request_body_sha256",
        "recorded_at",
        "subject",
        "claims",
        "next_cursor"
      ],
      "properties": {
        "contract": {
          "const": "delivery-claim/1"
        },
        "form": {
          "const": "RESULT"
        },
        "request_id": {
          "$ref": "#/$defs/token"
        },
        "idempotency_key": {
          "$ref": "#/$defs/token"
        },
        "request_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "subject": {
          "$ref": "#/$defs/serverSubject"
        },
        "claims": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "serverSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "credential_id",
        "principal_id",
        "subject_type",
        "host_id",
        "authorized_seat_ids",
        "capabilities",
        "binding_event_id",
        "binding_revision",
        "revocation_checked_at",
        "revoked"
      ],
      "properties": {
        "source": {
          "const": "SERVER_BOUND"
        },
        "credential_id": {
          "$ref": "#/$defs/token"
        },
        "principal_id": {
          "$ref": "#/$defs/token"
        },
        "subject_type": {
          "enum": [
            "AGENT",
            "HOST_COURIER",
            "SERVICE"
          ]
        },
        "host_id": {
          "$ref": "#/$defs/token"
        },
        "authorized_seat_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "townsquare.delivery.claim"
          },
          "minContains": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "binding_event_id": {
          "$ref": "#/$defs/token"
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 0
        },
        "revocation_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked": {
          "const": false
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "lease_epoch",
        "leased_at",
        "lease_expires_at",
        "pointer"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/token"
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "leased_at": {
          "type": "string",
          "format": "date-time"
        },
        "lease_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "pointer": {
          "$ref": "#/$defs/pointer"
        }
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "delivery_id",
        "notice_id",
        "event_id",
        "generation",
        "recipient_agent_id",
        "recipient_host_id",
        "recipient_seat_id",
        "source_target",
        "courier_profile",
        "route_evidence"
      ],
      "properties": {
        "contract": {
          "const": "notice-pointer/1"
        },
        "delivery_id": {
          "$ref": "#/$defs/token"
        },
        "notice_id": {
          "$ref": "#/$defs/token"
        },
        "event_id": {
          "$ref": "#/$defs/token"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "recipient_agent_id": {
          "$ref": "#/$defs/token"
        },
        "recipient_host_id": {
          "$ref": "#/$defs/token"
        },
        "recipient_seat_id": {
          "$ref": "#/$defs/token"
        },
        "source_target": {
          "$ref": "#/$defs/targetRef"
        },
        "courier_profile": {
          "enum": [
            "HOST_COURIER",
            "DIRECT_AGENT"
          ]
        },
        "route_evidence": {
          "$ref": "#/$defs/routeEvidence"
        }
      }
    },
    "targetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "kind",
        "id"
      ],
      "properties": {
        "contract": {
          "const": "target-ref/1"
        },
        "kind": {
          "enum": [
            "AGENT",
            "HOST"
          ]
        },
        "id": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "routeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "snapshot_id",
        "watermark",
        "canonical_sha256",
        "recipients_sha256",
        "recipient_sha256"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/token"
        },
        "snapshot_id": {
          "$ref": "#/$defs/token"
        },
        "watermark": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recipients_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recipient_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
