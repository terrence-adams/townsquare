          "$ref": "#/$defs/failureCode"
        },
        "correlation_id": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "form",
        "request_id",
        "idempotency_key",
        "request_body_sha256",
        "delivery_id",
        "delivery_event_id",
        "claim_id",
        "lease_epoch",
        "recipient_agent_id",
        "recipient_host_id",
        "recipient_seat_id",
