        "delivery_id",
        "claim_id",
        "lease_epoch",
        "failure_code",
        "correlation_id"
      ],
      "properties": {
        "contract": {
          "const": "delivery-fail/1"
        },
        "form": {
          "const": "REQUEST"
        },
        "request_id": {
          "$ref": "#/$defs/token"
        },
        "idempotency_key": {
          "$ref": "#/$defs/token"
        },
        "request_body_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "delivery_id": {
          "$ref": "#/$defs/token"
        },
        "claim_id": {
          "$ref": "#/$defs/token"
