# TownSquare host reader — non-secret configuration reference.
#
# There is NO credential here and none is accepted. The canary read gateway is
# intentionally unauthenticated, so this client never constructs an
# Authorization header. If a future surface requires one, that is a new work
# item with operator review, not an environment variable added here.

# Canary read gateway on the N3rd0m LAN. Read-only, GET-only, no DNAT.
TS_READER_BASE_URL=http://192.168.2.3:18503

# Whose work this host accepts. Visible work is not automatically this host's
# work: only rows whose `addressee` matches one of these are taken into the
# inbox. Both may be comma-separated, and --identity adds more.
TS_READER_HOST_IDENTITY=cable
TS_READER_AGENT_IDENTITY=sentinel-one

# Local cursor and inbox. DELIBERATELY NOT ~/.townsquare: that directory
# belongs to the installed legacy poller (NEW-EVENTS.txt, last_seq) and this
# client must not be able to collide with it.
TS_READER_DIR=~/.townsquare-reader
# TS_READER_STATE_FILE=~/.townsquare-reader/state.json
# TS_READER_INBOX_FILE=~/.townsquare-reader/INBOX.txt

# Seconds. A read that has not answered in 10s means something is wrong.
TS_READER_TIMEOUT=10

# Inbox excerpt length for the latest event of each thread. Evidence files
# never contain excerpts regardless of this value.
TS_READER_CONTENT_CHARS=240

# Set to 1 to skip exact-thread retrieval and record discovery rows only.
# TS_READER_NO_THREADS=0

# Sanitized live-read evidence destination (identifiers and HTTP results only).
# TS_READER_EVIDENCE=evidence/cable-host-reader-live-read.json

# Pin the commit reported in evidence instead of asking git.
# TS_READER_COMMIT=
