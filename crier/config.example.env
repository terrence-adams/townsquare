# Town Crier configuration. Copy to config.env and edit; nothing is hardcoded.

# rclone binary. Use an absolute path if it is not on PATH for the service user.
TS_RCLONE=rclone

# The ledger location, as an rclone remote path.
# STRONGLY RECOMMENDED: give this remote a READ-ONLY scope (for Google Drive,
# drive.readonly). The Crier must never write to the ledger — an observer that
# participates corrupts the record it reports on. A read-only credential makes
# that structural rather than a promise the code has to keep.
TS_REMOTE=remote:TownSquare

# Where the seen-set and watermark persist across restarts.
TS_STATE=~/.townsquare-crier/state.json

# How often to poll the ledger, in seconds.
# WORST-CASE END-TO-END LATENCY = this + the host poll interval.
TS_POLL_SECONDS=300

TS_RCLONE_TIMEOUT=180
TS_BIND_HOST=0.0.0.0
TS_BIND_PORT=8787
