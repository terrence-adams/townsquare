{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vertical-filing-draft.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project",
    "program_key",
    "filing_coordination",
    "source_refs",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "townsquare-vertical-filing-draft-v1"},
    "status": {"const": "DRAFT_NOT_FILED"},
    "project": {"const": "townsquare"},
    "program_key": {"type": "string", "minLength": 1},
    "filing_coordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designated_writer",
        "coordination_hub_reference",
        "serialization_protocol",
        "conflict_action"
      ],
      "properties": {
        "designated_writer": {"const": "eddie-brock"},
        "coordination_hub_reference": {"const": "operator-designated Eddie Brock coordination hub"},
        "serialization_protocol": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "conflict_action": {"const": "STOP_REBASE_REREVIEW"}
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "items": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "text"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_ref",
        "work_item_key",
        "title",
        "vertical_level",
        "parent_key",
        "depends_on_keys",
        "owner",
        "addressee",
        "review_owner",
        "operator_acceptance_owner",
        "environment",
        "state",
        "implementation_authorized",
        "dispatch_authorized_by_this_draft",
        "priority",
        "goal",
        "acceptance_criteria",
        "evidence_required",
        "separate_authority_required",
        "native_open_event"
      ],
      "properties": {
        "proposal_ref": {"type": "string", "pattern": "^DRAFT-TSDEF-(E1|F[1-5]|S([1-9]|10))$"},
        "work_item_key": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "vertical_level": {"enum": ["EPIC", "FEATURE", "STORY"]},
        "parent_key": {"type": ["string", "null"]},
        "depends_on_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "owner": {"const": "eddie-brock"},
        "addressee": {"type": "string", "minLength": 1},
        "review_owner": {"type": "string", "minLength": 1},
        "operator_acceptance_owner": {"const": "operator"},
        "environment": {"type": "string", "minLength": 1},
        "state": {"const": "OPEN"},
        "implementation_authorized": {"const": true},
        "dispatch_authorized_by_this_draft": {"const": false},
        "priority": {"enum": ["TOP", "HIGH", "NORMAL"]},
        "goal": {"type": "string", "minLength": 1},
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/criterion"}
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "separate_authority_required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "native_open_event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "idempotency_key", "payload"],
          "properties": {
            "revision": {"const": "new"},
            "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
            "payload": {
              "type": "object",
              "required": [
                "thread_id",
                "kind",
                "state",
                "body",
                "media_type",
                "sensitivity",
                "owner",
                "addressee",
                "criteria_refs"
              ],
              "properties": {
                "thread_id": {"type": "string", "minLength": 1, "maxLength": 200},
                "kind": {"const": "REQUEST"},
                "state": {"const": "OPEN"},
                "body": {"type": "string", "minLength": 1},
                "media_type": {"enum": ["text/markdown", "text/plain"]},
                "sensitivity": {"enum": ["INTERNAL", "RESTRICTED"]},
                "owner": {"const": "eddie-brock"},
                "addressee": {"type": "string", "minLength": 1},
                "criteria_refs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
