      "selection": "criteria fixed at opening plus later operator-authorized amendments, preserving supersession history",
      "ordering": "criterion identity ascending",
      "empty_set": "for a Request action, an empty set parks the action with a named requirement",
      "hashing": "sha256 of each canonical criterion and disposition requirement plus an aggregate sha256"
    }
