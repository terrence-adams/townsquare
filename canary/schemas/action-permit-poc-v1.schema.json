{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action-permit-poc-v1.schema.json",
  "title": "TownSquare exact-action single-use permit POC immutable binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "permit_id",
    "bearer_hmac_sha256",
    "actor",
    "action",
    "target",
    "payload",
    "mutation",
    "authority_basis",
    "governance",
    "decision_record",
    "audience",
    "lifetime"
  ],
  "properties": {
    "schema": {"const": "townsquare-action-permit-poc-v1"},
    "permit_id": {"$ref": "#/$defs/nonempty"},
    "bearer_hmac_sha256": {"$ref": "#/$defs/sha256"},
    "actor": {
      "type": "object",
      "$comment": "credential_id is derived from the authenticated credential row and is never accepted from request JSON.",
      "additionalProperties": false,
      "required": ["authenticated_principal", "credential_id", "registered_identity_fixture_ref", "registered_identity_fixture_sha256"],
      "properties": {
        "authenticated_principal": {"$ref": "#/$defs/nonempty"},
        "credential_id": {"$ref": "#/$defs/nonempty"},
        "registered_identity_fixture_ref": {"$ref": "#/$defs/nonempty"},
        "registered_identity_fixture_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": {"type": "string", "pattern": "^request:[a-z][a-z0-9_-]{0,63}$"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "expected_revision"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "expected_revision": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalization_profile", "canonical_payload_sha256"],
      "properties": {
        "canonicalization_profile": {"const": "townsquare-json-v1"},
        "canonical_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "idempotency_key_sha256"],
      "properties": {
        "operation": {"const": "post"},
        "idempotency_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "authority_basis": {
      "type": "object",
      "$comment": "Service logic derives this object from the hash-pinned read-only ledger-context manifest and enforces exact-one item selection, byte/digest equality, trusted custody, and all parsed snapshot predicates.",
      "additionalProperties": false,
      "required": ["kind", "authority_manifest_id", "authority_manifest_file_sha256", "vertical_story", "verified_canary_proof"],
      "properties": {
        "kind": {"const": "VERTICAL_STORY"},
        "authority_manifest_id": {"$ref": "#/$defs/nonempty"},
        "authority_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "vertical_story": {
          "type": "object",
          "$comment": "Service logic must verify that the snapshot URN digest suffix, source_snapshot_sha256, SHA-256 of the retained exact UTF-8 bytes, and fields parsed from those bytes all agree; JSON Schema cannot express that cross-field and external-byte invariant.",
          "additionalProperties": false,
          "required": ["story_key", "thread_id", "opening_event_id", "opening_content_sha256", "source_status", "source_version", "head_event_id", "head_content_sha256", "retrieved_at", "source_snapshot_ref", "source_snapshot_sha256", "review_gate", "helio_checkpoint"],
          "properties": {
            "story_key": {"const": "IRON-CURTAIN-PERMIT-POC-CANARY"},
            "thread_id": {"const": "01a11b47-a6b6-71f1-9348-0d1e9ed21c5d"},
            "opening_event_id": {"const": "01a11b47-a6b7-7372-b52f-2d2002ed2081"},
            "opening_content_sha256": {"const": "9a1cbf7ddff351494331f9da521863fa37d232093c7fe1043bd73541b3645f87"},
            "source_status": {"const": "WORKING"},
            "source_version": {"$ref": "#/$defs/nonempty"},
            "head_event_id": {"$ref": "#/$defs/nonempty"},
            "head_content_sha256": {"$ref": "#/$defs/sha256"},
            "retrieved_at": {"$ref": "#/$defs/timestamp"},
            "source_snapshot_ref": {"type": "string", "pattern": "^urn:ynm:vertical-story-snapshot:v1:sha256:[0-9a-f]{64}$"},
            "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
            "review_gate": {
              "type": "object", "additionalProperties": false, "required": ["story_key", "relationship", "disposition", "event_id", "content_sha256"],
              "properties": {"story_key": {"const": "IRON-CURTAIN-PERMIT-POC-REVIEW"}, "relationship": {"const": "DEPENDS_ON"}, "disposition": {"const": "ACCEPTED"}, "event_id": {"$ref": "#/$defs/nonempty"}, "content_sha256": {"$ref": "#/$defs/sha256"}}
            },
            "helio_checkpoint": {
              "type": "object", "additionalProperties": false, "required": ["scope_story_key", "gate", "disposition", "event_id", "content_sha256"],
              "properties": {"scope_story_key": {"const": "IRON-CURTAIN-PERMIT-POC-CANARY"}, "gate": {"const": "CANARY_HANDOFF"}, "disposition": {"const": "PROCEED"}, "event_id": {"$ref": "#/$defs/nonempty"}, "content_sha256": {"$ref": "#/$defs/sha256"}}
            }
          }
        },
        "verified_canary_proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "profile", "canonical_preimage_sha256", "signature_evidence_ref", "signature_evidence_sha256", "key_id", "nonce_sha256"],
          "properties": {
            "schema": {"const": "townsquare-action-permit-canary-proof-v1"},
            "profile": {"const": "townsquare-action-permit-canary-proof-v1"},
            "canonical_preimage_sha256": {"$ref": "#/$defs/sha256"},
            "signature_evidence_ref": {"$ref": "#/$defs/nonempty"},
            "signature_evidence_sha256": {"$ref": "#/$defs/sha256"},
            "key_id": {"$ref": "#/$defs/nonempty"},
            "nonce_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "manifest_sha256", "bundle_id", "bundle_sha256", "charter_version", "required_items_sha256"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/nonempty"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_id": {"$ref": "#/$defs/nonempty"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "charter_version": {"$ref": "#/$defs/nonempty"},
        "required_items_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "canonical_sha256"],
      "properties": {
        "record": {"$ref": "#/$defs/decisionRecord"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "service_id", "endpoint"],
      "properties": {
        "api": {"const": "townsquare-canary-ledger-api"},
        "service_id": {"const": "townsquare-ledger-v0"},
        "endpoint": {"const": "/v1/events"}
      }
    },
    "lifetime": {
      "type": "object",
      "$comment": "Service logic enforces expires_at = issued_at + exactly 120 seconds, issued_at <= first_use_now < expires_at, no grace, and one fixed injectable UTC clock.",
      "additionalProperties": false,
      "required": ["issued_at", "expires_at", "ttl_seconds", "key_id", "state", "single_use", "max_uses"],
      "properties": {
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "ttl_seconds": {"const": 120},
        "key_id": {"$ref": "#/$defs/nonempty"},
        "state": {"const": "ISSUED"},
        "single_use": {"const": true},
        "max_uses": {"const": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 512},
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "evidence_references", "assumptions", "selected_action", "applicable_rules", "expected_outcome"],
      "properties": {
        "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "statement"],
            "properties": {
              "label": {"enum": ["stated", "inferred", "verified"]},
              "statement": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        },
        "selected_action": {"type": "string", "minLength": 1, "maxLength": 2000},
        "applicable_rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "expected_outcome": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
